# stream-hub environment configuration
# ------------------------------------
# Copy this file to `.env` and fill in the keys you have. Every key is OPTIONAL —
# with none set, stream-hub runs fully offline on its bundled catalog of 22 titles.
#
#   cp .env.example .env
#
# After editing .env, restart the app (or `sudo systemctl restart stream-hub` on a Pi).
# The .env file is gitignored and must never be committed.

# --- Server ---
# Port the app serves on. Default is 5000 if unset.
PORT=5000
# NODE_ENV=production is set automatically by setup.py / the systemd service.
# NODE_ENV=production

# --- Catalog / metadata / trailers ---
# TMDB powers live catalog, posters, and trailer lookups.
# Get a free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Ratings (IMDb / Rotten Tomatoes / Metacritic) ---
# OMDb supplies the three rating scores shown on each result bar.
# Get a free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Streaming availability ---
# Watchmode tells stream-hub which service has each title and whether it's
# free/included vs. rent/buy (drives the "include pay" filtering).
# Get a key: https://api.watchmode.com/
WATCHMODE_API_KEY=

# --- AI natural-language search ---
# Lets the app interpret queries like "that movie with the spinning top".
# Without it, stream-hub falls back to a built-in keyword/genre matcher.
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Per-service account secrets (optional / advanced) ---
# If you later wire an availability provider tied to your own streaming accounts,
# add those credentials here and reference them from server/providers.ts.
# Example:
# NETFLIX_SESSION_TOKEN=
